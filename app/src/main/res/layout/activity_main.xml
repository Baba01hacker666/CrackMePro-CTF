<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#0F1115">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CrackMePro CTF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Free app · $4.99 PRO unlocks the Flag Vault"
            android:textColor="#9AA4B2"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: FREE"
            android:textColor="#7CFC98"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="#1A2230"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buyBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upgrade to PRO"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/vaultBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open PRO Vault (flag)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/checkBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run RASP self-test"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/raspText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RASP: not checked yet"
            android:textColor="#FFC857"
            android:padding="10dp"
            android:background="#1A2230"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/flagText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textIsSelectable="true"
            android:padding="12dp"
            android:background="#1A2230" />
    </LinearLayout>
</ScrollView>
